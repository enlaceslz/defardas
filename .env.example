# DE FARDAS ERP — Environment Variables Configuration Template
# Preencha as variáveis correspondentes no seu arquivo .env em produção

# Configurações do Servidor
PORT=3000
NODE_ENV=production
APP_URL="https://erp.defardas.com.br"

# Banco de Dados Principal (PostgreSQL Próprio - Drizzle ORM)
DATABASE_URL="postgresql://defardas_user:change_in_production@defardas-postgres:5432/defardas_db?sslmode=disable"
DATABASE_SSL_MODE="disable"
# Para banco remoto com TLS, use verify-full e configure DATABASE_CA_CERT.
POSTGRES_PASSWORD=""
DATABASE_CA_CERT=""

# Cache e Filas de Processamento (Redis)
REDIS_URL="redis://defardas-redis:6379"

# Armazenamento Privado Compatível com S3 (Documentos, Comprovantes e Fichas)
S3_ENDPOINT="https://s3.defardas.com.br"
S3_REGION="us-east-1"
S3_BUCKET_NAME="defardas-private-docs"
S3_ACCESS_KEY_ID="MY_S3_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="MY_S3_SECRET_KEY"
S3_FORCE_PATH_STYLE="true"

# Central WhatsApp — Provedor 1: Meta WhatsApp Cloud API (Oficial)
META_WA_TOKEN="EAAG..."
META_WA_PHONE_NUMBER_ID=""
META_WA_BUSINESS_ACCOUNT_ID=""
META_WA_WEBHOOK_VERIFY_TOKEN=""

# Central WhatsApp — Provedor 2: WA-AKG QR Code (Serviço Isolado)
WA_AKG_ENDPOINT="http://defardas-wa-akg:8080"
WA_AKG_API_KEY=""

# Gemini AI (Inteligência Gerencial e Análise de Produção)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Autenticação dos webhooks de entrada (obrigatória para receber mensagens)
META_WA_APP_SECRET=""
WA_AKG_WEBHOOK_SECRET=""
