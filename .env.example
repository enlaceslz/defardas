# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for client's dedicated production database
# Example: postgresql://defardas_user:password@localhost:5432/defardas_db?sslmode=prefer
DATABASE_URL="postgresql://defardas_user:password@localhost:5432/defardas_db"

# S3-Compatible Private Storage Configuration (MinIO, AWS S3, or Cloudflare R2)
S3_ENDPOINT="https://s3.defardas.com.br"
S3_REGION="us-east-1"
S3_BUCKET_NAME="defardas-private-docs"
S3_ACCESS_KEY_ID="MY_S3_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="MY_S3_SECRET_KEY"
S3_FORCE_PATH_STYLE="true"
