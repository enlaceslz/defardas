# DE FARDAS ERP — Environment Variables Configuration Template
# Preencha as variáveis correspondentes no seu arquivo .env em produção

# Configurações do Servidor
PORT=3000
# Porta HTTP somente no loopback por padrão; colocar HTTPS em proxy reverso.
APP_BIND_ADDRESS=127.0.0.1
NODE_ENV=production
APP_URL="https://erp.defardas.com.br"

# Banco de Dados Principal (PostgreSQL Próprio - Drizzle ORM)
DATABASE_URL="postgresql://defardas_user:change_in_production@defardas-postgres:5432/defardas_db?sslmode=disable"
DATABASE_SSL_MODE="disable"
# Modos aceitos: disable, require, verify-full. require/verify-full validam certificado.
# Para banco remoto, use verify-full e configure DATABASE_CA_CERT quando necessário.
# Não colocar sslcert/sslkey/sslrootcert/ssl/uselibpqcompat na URL.
# sslmode na URL só é aceito se idêntico a DATABASE_SSL_MODE; prefira omitir.
DATABASE_POOL_MAX=20
DATABASE_ALLOW_INSECURE_SSL=false
POSTGRES_PASSWORD=""
DATABASE_CA_CERT=""

# Redis reservado; aplicação atual não usa sessões/cache/filas Redis.
# Compose inicia Redis apenas com --profile optional-cache.
REDIS_URL=""

# S3 ainda não implementado: preencher variáveis não habilita upload/validação privada.
# Armazenamento Privado Compatível com S3 (Documentos, Comprovantes e Fichas)
S3_ENDPOINT="https://s3.defardas.com.br"
S3_REGION="us-east-1"
S3_BUCKET_NAME="defardas-private-docs"
S3_ACCESS_KEY_ID="MY_S3_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="MY_S3_SECRET_KEY"
S3_FORCE_PATH_STYLE="true"

# Central WhatsApp — Provedor 1: Meta WhatsApp Cloud API (Oficial)
META_WA_TOKEN="EAAG..."
META_WA_PHONE_NUMBER_ID=""
# UUID do canal Meta persistido em communication.channels
META_WA_CHANNEL_ID=""
META_WA_BUSINESS_ACCOUNT_ID=""
META_WA_WEBHOOK_VERIFY_TOKEN=""

# Central WhatsApp — Provedor 2: WA-AKG QR Code (Serviço Isolado)
WA_AKG_ENDPOINT=""
# Endpoint explícito de serviço real homologado; Compose não inicia simulador.
WA_AKG_API_KEY=""
# UUID do canal WA-AKG persistido em communication.channels
WA_AKG_CHANNEL_ID=""

# Gemini AI (Inteligência Gerencial e Análise de Produção)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Autenticação dos webhooks de entrada (obrigatória para receber mensagens)
META_WA_APP_SECRET=""
WA_AKG_WEBHOOK_SECRET=""
